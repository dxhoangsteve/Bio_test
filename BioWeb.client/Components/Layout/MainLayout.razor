@inherits LayoutComponentBase

<!-- Fixed Header -->
<nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold fs-4" href="/">Portfolio</a>
        <div class="navbar-nav ms-auto">
            <a class="nav-link" href="/me/admin/login">
                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
            </a>
        </div>
    </div>
</nav>

<!-- Main Content with top padding for fixed header -->
<div class="main-content">
    @Body
</div>



@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool IsActive(string href)
    {
        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (href == "/" && string.IsNullOrEmpty(currentPath))
            return true;
        return currentPath.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
    }
}
