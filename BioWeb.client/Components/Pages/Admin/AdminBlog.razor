@page "/admin/blog"
@using BioWeb.Shared.Models.DTOs
@using BioWeb.client.Services
@using BioWeb.client.Components
@inject IApiService ApiService
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Quản trị Blog</PageTitle>

<link href="css/admin-blog.css" rel="stylesheet" />

<AdminGuard>
    <!-- Fixed Header -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4" href="/admin/blog">
                <i class="fas fa-blog me-2"></i>Quản trị Blog
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="/admin/bio">
                    <i class="fas fa-user me-2"></i>Hồ sơ
                </a>
                <button class="btn btn-outline-danger btn-sm ms-2" @onclick="Logout">
                    <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                </button>
            </div>
        </div>
    </nav>

    <!-- Server Status Component -->
    <ServerStatusComponent IsServerDown="@isServerDown" ErrorMessage="@serverErrorMessage" OnRetry="@HandleRetry" />

    @if (!isServerDown)
    {
        @if (isLoading)
        {
            <div class="main-content">
                <div class="blog-container">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-3">Đang tải blog...</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="main-content">
                <div class="blog-container">
                    @if (!showArticleDetail)
                    {
                        @if (categories != null && categories.Any())
                        {
                            <div class="card shadow-sm mb-4">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-tags me-2"></i>Chủ đề
                                        </h5>
                                        <div>
                                            <button class="btn btn-success btn-sm me-2" @onclick="ShowAddCategory">
                                                <i class="fas fa-plus me-2"></i>Thêm chủ đề
                                            </button>
                                            <button class="btn btn-outline-primary btn-sm" @onclick="ShowManageCategories">
                                                <i class="fas fa-cog me-2"></i>Quản lý
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <!-- Horizontal scrollable categories for all devices -->
                                    <div class="overflow-auto">
                                        <div class="d-flex gap-2 flex-nowrap pb-2">
                                            <button class="btn @(selectedCategoryId == 0 ? "btn-dark" : "btn-outline-secondary") btn-sm rounded-pill flex-shrink-0"
                                                    @onclick="() => FilterByCategory(0)">
                                                Tất cả
                                            </button>
                                            @foreach (var category in categories)
                                            {
                                                <div class="position-relative flex-shrink-0">
                                                    <button class="btn @(selectedCategoryId == category.CategoryID ? "btn-dark" : "btn-outline-secondary") btn-sm rounded-pill"
                                                            @onclick="() => FilterByCategory(category.CategoryID)">
                                                        @category.CategoryName
                                                    </button>
                                                    @if (selectedCategoryId == category.CategoryID)
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning position-absolute top-0 start-100 translate-middle rounded-circle category-edit-btn"
                                                                @onclick="() => ShowEditCategory(category)" style="width: 25px; height: 25px; padding: 0;">
                                                            <i class="fas fa-edit" style="font-size: 0.7rem;"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Articles Container -->
                        <div class="card shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-newspaper me-2"></i>Bài viết
                                    </h5>
                                    <button class="btn btn-success btn-sm" @onclick="ShowAddArticle">
                                        <i class="fas fa-plus me-2"></i>Thêm bài viết
                                    </button>
                                </div>

                                @if (filteredArticles != null && filteredArticles.Any())
                                {
                                    <div class="row g-4">
                                        @foreach (var article in filteredArticles)
                                        {
                                            <div class="col-lg-6 col-md-6 col-12">
                                                <div class="card bg-light border-0 h-100 article-hover position-relative">
                                                    <div class="card-body px-4 py-3">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <h6 class="card-title fw-bold mb-0 text-truncate flex-grow-1 me-2" 
                                                                style="cursor: pointer;" @onclick="() => ViewArticle(article)">
                                                                @article.Title
                                                            </h6>
                                                            <div class="dropdown">
                                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" 
                                                                        data-bs-toggle="dropdown">
                                                                    <i class="fas fa-ellipsis-v"></i>
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                    <li><a class="dropdown-item" href="#" @onclick="() => ShowEditArticle(article)">
                                                                        <i class="fas fa-edit me-2"></i>Sửa
                                                                    </a></li>
                                                                    <li><a class="dropdown-item" href="#" @onclick="() => TogglePublishArticle(article)">
                                                                        <i class="fas @(article.IsPublished ? "fa-eye-slash" : "fa-eye") me-2"></i>
                                                                        @(article.IsPublished ? "Ẩn" : "Hiện")
                                                                    </a></li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                    <li><a class="dropdown-item text-danger" href="#" @onclick="() => ShowDeleteArticle(article)">
                                                                        <i class="fas fa-trash me-2"></i>Xóa
                                                                    </a></li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div class="text-muted small">
                                                                <i class="fas fa-calendar me-1"></i>@article.CreatedAt.ToString("dd/MM/yyyy")
                                                            </div>
                                                            <span class="badge @(article.IsPublished ? "bg-success" : "bg-secondary")">
                                                                @(article.IsPublished ? "Đã xuất bản" : "Nháp")
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="fas fa-file-alt fa-3x text-muted mb-3"></i>
                                        <h5>
                                            @if (selectedCategoryId == 0)
                                            {
                                                <span>Chưa có bài viết nào</span>
                                            }
                                            else
                                            {
                                                <span>Không có bài viết trong chủ đề này</span>
                                            }
                                        </h5>
                                        <p class="text-muted">Hãy thêm bài viết đầu tiên!</p>
                                        <button class="btn btn-primary" @onclick="ShowAddArticle">
                                            <i class="fas fa-plus me-2"></i>Thêm bài viết
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Article Detail View -->
                        <div class="card shadow-sm">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="BackToArticles">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </button>
                                <div>
                                    <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => ShowEditArticle(selectedArticle)">
                                        <i class="fas fa-edit me-2"></i>Sửa bài viết
                                    </button>
                                    <span class="badge @(selectedArticle?.IsPublished == true ? "bg-success" : "bg-secondary")">
                                        @(selectedArticle?.IsPublished == true ? "Đã xuất bản" : "Nháp")
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (selectedArticle != null)
                                {
                                    <h2 class="mb-3">@selectedArticle.Title</h2>
                                    <div class="d-flex gap-3 mb-4 text-muted">
                                        <span><i class="fas fa-tag me-1"></i>@selectedArticle.CategoryName</span>
                                        <span><i class="fas fa-calendar me-1"></i>@selectedArticle.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="article-content">
                                        @((MarkupString)selectedArticle.Content)
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>
        }
    }
</AdminGuard>

@code {
    private List<ArticleDto> articles = new();
    private List<ArticleDto> filteredArticles = new();
    private List<CategoryDto> categories = new();
    private ArticleDto? selectedArticle;
    private bool showArticleDetail = false;
    private int selectedCategoryId = 0;
    private bool isLoading = true;
    private bool isServerDown = false;
    private string serverErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to server status changes
        ApiService.ServerStatusChanged += OnServerStatusChanged;

        // Check server health first
        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBlogData();
        }
    }

    private void OnServerStatusChanged(bool isHealthy, string errorMessage)
    {
        isServerDown = !isHealthy;
        serverErrorMessage = errorMessage;

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadBlogData()
    {
        try
        {
            isLoading = true;

            // Load articles and categories concurrently
            var articlesTask = ApiService.GetPublishedArticlesAsync();
            var categoriesTask = ApiService.GetCategoriesAsync();

            await Task.WhenAll(articlesTask, categoriesTask);

            articles = await articlesTask;
            categories = await categoriesTask;
            filteredArticles = articles;

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading blog data: {ex.Message}");
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRetry()
    {
        isServerDown = false;
        serverErrorMessage = "";
        StateHasChanged();

        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBlogData();
        }
    }

    private async Task FilterByCategory(int categoryId)
    {
        try
        {
            selectedCategoryId = categoryId;
            isLoading = true;
            StateHasChanged();

            if (categoryId == 0)
            {
                filteredArticles = await ApiService.GetPublishedArticlesAsync();
            }
            else
            {
                filteredArticles = await ApiService.GetArticlesByCategoryAsync(categoryId);
            }

            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering articles: {ex.Message}");
            isLoading = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private void ViewArticle(ArticleDto article)
    {
        selectedArticle = article;
        showArticleDetail = true;
        StateHasChanged();
    }

    private void BackToArticles()
    {
        selectedArticle = null;
        showArticleDetail = false;
        StateHasChanged();
    }

    // Admin functions - placeholder for now
    private void ShowAddCategory() => Console.WriteLine("Add Category");
    private void ShowManageCategories() => Console.WriteLine("Manage Categories");
    private void ShowEditCategory(CategoryDto category) => Console.WriteLine($"Edit Category: {category.CategoryName}");
    private void ShowAddArticle() => Console.WriteLine("Add Article");
    private void ShowEditArticle(ArticleDto article) => Console.WriteLine($"Edit Article: {article.Title}");
    private void ShowDeleteArticle(ArticleDto article) => Console.WriteLine($"Delete Article: {article.Title}");
    private void TogglePublishArticle(ArticleDto article) => Console.WriteLine($"Toggle Publish: {article.Title}");

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/me/admin/login");
    }

    public void Dispose()
    {
        ApiService.ServerStatusChanged -= OnServerStatusChanged;
    }
}
