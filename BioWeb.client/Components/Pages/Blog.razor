@page "/blog"
@using BioWeb.Shared.Models.DTOs
@using BioWeb.client.Services
@using BioWeb.client.Components
@inject IApiService ApiService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Blog - Xuan Hoang</PageTitle>

<!-- Server Status Component -->
<ServerStatusComponent IsServerDown="@isServerDown" ErrorMessage="@serverErrorMessage" OnRetry="@HandleRetry" />

@if (!isServerDown)
{
    @if (isLoading)
    {
        <div class="main-content">
            <div class="blog-container">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-3">Đang tải bài viết...</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="main-content">
            <div class="blog-container">
                <!-- Blog Header Card -->
                <div class="blog-header-card">
                    <h1 class="blog-title">Báo chí & Truyền thông</h1>
                    <p class="blog-subtitle">Chia sẻ kiến thức và kinh nghiệm</p>
                </div>

                <!-- Category Filter Card -->
                @if (categories != null && categories.Any())
                {
                    <div class="category-filter-card">
                        <h3 class="filter-title">Chủ đề</h3>

                        <div class="category-filters">
                            <button class="btn category-filter @(selectedCategoryId == 0 ? "active" : "")"
                                    @onclick="() => FilterByCategory(0)">
                                Tất cả
                            </button>
                            @foreach (var category in categories)
                            {
                                <button class="btn category-filter @(selectedCategoryId == category.CategoryID ? "active" : "")"
                                        @onclick="() => FilterByCategory(category.CategoryID)">
                                    @category.CategoryName
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- Articles Container -->
                <div class="articles-container">
                    @if (filteredArticles != null && filteredArticles.Any())
                    {
                        <div class="articles-grid">
                            @foreach (var article in filteredArticles)
                            {
                                <div class="article-card" @onclick="() => ViewArticle(article)">
                                    <h3 class="article-title">@article.Title</h3>
                                    <div class="article-meta">
                                        <span><i class="fas fa-tag"></i> @article.CategoryName</span>
                                        <span><i class="fas fa-calendar"></i> @article.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="article-content">
                                        @if (article.Content.Length > 150)
                                        {
                                            @((MarkupString)(article.Content.Substring(0, 150) + "..."))
                                        }
                                        else
                                        {
                                            @((MarkupString)article.Content)
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-file-alt"></i>
                            <h4>
                                @if (selectedCategoryId == 0)
                                {
                                    <span>Chưa có bài viết nào</span>
                                }
                                else
                                {
                                    <span>Không có bài viết trong chủ đề này</span>
                                }
                            </h4>
                            <p>Hãy quay lại sau để đọc những bài viết mới nhất!</p>
                        </div>
                    }
                </div>

                <!-- Article Detail Modal -->
                @if (selectedArticle != null && showArticleDetail)
                {
                    <div class="article-modal" @onclick="CloseArticleDetail">
                        <div class="article-modal-content" @onclick:stopPropagation="true">
                            <div class="article-modal-header">
                                <h2 class="article-modal-title">@selectedArticle.Title</h2>
                                <button class="close-button" @onclick="CloseArticleDetail">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <div class="article-modal-meta">
                                <span><i class="fas fa-tag"></i> @selectedArticle.CategoryName</span>
                                <span><i class="fas fa-calendar"></i> @selectedArticle.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="article-modal-body">
                                @((MarkupString)selectedArticle.Content)
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<ArticleDto> articles = new();
    private List<ArticleDto> filteredArticles = new();
    private List<CategoryDto> categories = new();
    private ArticleDto? selectedArticle;
    private bool showArticleDetail = false;
    private int selectedCategoryId = 0;
    private bool isLoading = true;
    private bool isServerDown = false;
    private string serverErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to server status changes
        ApiService.ServerStatusChanged += OnServerStatusChanged;

        // Check server health first
        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBlogData();
        }
    }

    private void OnServerStatusChanged(bool isHealthy, string errorMessage)
    {
        isServerDown = !isHealthy;
        serverErrorMessage = errorMessage;

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadBlogData()
    {
        try
        {
            isLoading = true;

            // Load articles and categories concurrently
            var articlesTask = ApiService.GetPublishedArticlesAsync();
            var categoriesTask = ApiService.GetCategoriesAsync();

            await Task.WhenAll(articlesTask, categoriesTask);

            articles = await articlesTask;
            categories = await categoriesTask;
            filteredArticles = articles;

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading blog data: {ex.Message}");
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRetry()
    {
        isServerDown = false;
        serverErrorMessage = "";
        StateHasChanged();

        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBlogData();
        }
    }

    private void FilterByCategory(int categoryId)
    {
        selectedCategoryId = categoryId;
        
        if (categoryId == 0)
        {
            filteredArticles = articles;
        }
        else
        {
            filteredArticles = articles.Where(a => a.CategoryID == categoryId).ToList();
        }
        
        StateHasChanged();
    }

    private void ViewArticle(ArticleDto article)
    {
        selectedArticle = article;
        showArticleDetail = true;
        StateHasChanged();
    }

    private void CloseArticleDetail()
    {
        selectedArticle = null;
        showArticleDetail = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("console.log", "Blog page loaded");
        }
    }

    public void Dispose()
    {
        ApiService.ServerStatusChanged -= OnServerStatusChanged;
    }
}
