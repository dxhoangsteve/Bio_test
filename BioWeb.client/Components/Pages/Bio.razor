@page "/"
@using BioWeb.Shared.Models.DTOs
@using BioWeb.client.Services
@using BioWeb.client.Components
@using Microsoft.AspNetCore.Components.Web
@inject IApiService ApiService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@(aboutMe?.FullName ?? "Xuan Hoang") - Bio</PageTitle>

<!-- Server Status Component -->
<ServerStatusComponent IsServerDown="@isServerDown" ErrorMessage="@serverErrorMessage" OnRetry="@HandleRetry" />

@if (!isServerDown)
{
    @if (isLoading)
    {
        <div class="main-content">
            <div class="bio-container">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="mt-3">Đang tải thông tin...</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="main-content bio-main">
            <!-- Bio Header Section - Full width -->
            <div class="bio-header">
                <div class="container">
                    <div class="row align-items-center">
                        <!-- Avatar Column -->
                        <div class="col-md-4 text-center mb-3 mb-md-0">
                            @if (aboutMe != null && !string.IsNullOrEmpty(aboutMe.AvatarURL))
                            {
                                <img src="@GetImageUrl(aboutMe.AvatarURL)" alt="@aboutMe.FullName"
                                     class="bio-avatar rounded-circle shadow" />
                            }
                            else
                            {
                                <div class="bio-avatar-placeholder rounded-circle shadow d-flex align-items-center justify-content-center">
                                    <i class="fas fa-user fa-3x text-muted"></i>
                                </div>
                            }
                        </div>

                        <!-- Info Column -->
                        <div class="col-md-8">
                            @if (aboutMe != null)
                            {
                                <h1 class="bio-name mb-2">
                                    Xin chào, tôi là <span class="text-primary">@aboutMe.FullName</span>
                                </h1>
                                <h2 class="bio-job-title mb-3">@aboutMe.JobTitle</h2>
                                @if (!string.IsNullOrEmpty(aboutMe.BioSummary))
                                {
                                    <p class="bio-summary text-muted lh-lg">@aboutMe.BioSummary</p>
                                }
                            }
                            else
                            {
                                <h1 class="bio-name">Đang tải thông tin...</h1>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Container -->
            <div class="bio-container">

                <!-- 3 Boxes Section -->
                <div class="info-boxes-section">
                    <div class="row g-4 mb-5">
                        <!-- Contact Box -->
                        <div class="col-lg-4 col-md-6">
                            <div class="info-box shadow-sm h-100">
                                <div class="info-box-header">
                                    <h5 class="info-box-title">
                                        <i class="fas fa-phone me-2 text-primary"></i>Liên hệ
                                    </h5>
                                </div>
                                <div class="info-box-body">
                                    @if (contact != null)
                                    {
                                        <div class="contact-items-container">
                                            @if (!string.IsNullOrEmpty(contact.Email))
                                            {
                                                <div class="contact-item">
                                                    <i class="fas fa-envelope text-muted me-2"></i>
                                                    <span>@contact.Email</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(contact.PhoneNumber))
                                            {
                                                <div class="contact-item">
                                                    <i class="fas fa-phone text-muted me-2"></i>
                                                    <span>@contact.PhoneNumber</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(contact.Address))
                                            {
                                                <div class="contact-item">
                                                    <i class="fas fa-map-marker-alt text-muted me-2"></i>
                                                    <span>@contact.Address</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">Đang tải thông tin...</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Social Media Box -->
                        <div class="col-lg-4 col-md-6">
                            <div class="info-box shadow-sm h-100">
                                <div class="info-box-header">
                                    <h5 class="info-box-title">
                                        <i class="fas fa-share-alt me-2 text-primary"></i>Mạng xã hội
                                    </h5>
                                </div>
                                <div class="info-box-body">
                                    @if (contact != null)
                                    {
                                        <div class="social-links">
                                            @if (!string.IsNullOrEmpty(contact.FacebookURL))
                                            {
                                                <a href="@contact.FacebookURL" target="_blank" class="social-btn facebook-btn"
                                                    title="Facebook">
                                                    <i class="fab fa-facebook-f me-2"></i>Facebook
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(contact.LinkedInURL))
                                            {
                                                <a href="@contact.LinkedInURL" target="_blank" class="social-btn linkedin-btn"
                                                    title="LinkedIn">
                                                    <i class="fab fa-linkedin-in me-2"></i>LinkedIn
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">Đang tải thông tin...</p>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Portfolio Box -->
                        <div class="col-lg-4 col-md-12">
                            <div class="info-box shadow-sm h-100">
                                <div class="info-box-header">
                                    <h5 class="info-box-title">
                                        <i class="fas fa-briefcase me-2 text-primary"></i>Portfolio
                                    </h5>
                                </div>
                                <div class="info-box-body">
                                    @if (contact != null)
                                    {
                                        <div class="portfolio-links">
                                            @if (!string.IsNullOrEmpty(contact.GitHubURL))
                                            {
                                                <a href="@contact.GitHubURL" target="_blank"
                                                    class="portfolio-btn github-portfolio">
                                                    <i class="fab fa-github me-2"></i>GitHub
                                                </a>
                                            }
                                            @if (!string.IsNullOrEmpty(contact.CV_FilePath))
                                            {
                                                <a href="@contact.CV_FilePath" target="_blank"
                                                    class="portfolio-btn cv-portfolio">
                                                    <i class="fas fa-file-pdf me-2"></i>Tải CV
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted">Đang tải thông tin...</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Projects Section - 80% width -->
                <div class="projects-section">
                    <div class="projects-container">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-center mb-4">
                                    <i class="fas fa-code me-2"></i>Các dự án đã tham gia
                                </h5>

                                @if (projects != null && projects.Any())
                                {
                                    <div class="row g-4">
                                        @foreach (var project in projects.Take(6))
                                        {
                                            <div class="col-lg-4 col-md-6 col-12">
                                                <div class="project-card h-100">
                                                    @if (!string.IsNullOrEmpty(project.ThumbnailURL))
                                                    {
                                                        <div class="project-image">
                                                            <img src="@project.ThumbnailURL" alt="@project.ProjectName" />
                                                            <div class="project-overlay">
                                                                <div class="project-links">
                                                                    @if (!string.IsNullOrEmpty(project.GitHubURL))
                                                                    {
                                                                        <a href="@project.GitHubURL" target="_blank" class="project-link github-link"
                                                                            title="GitHub">
                                                                            <i class="fab fa-github"></i>
                                                                        </a>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(project.ProjectURL))
                                                                    {
                                                                        <a href="@project.ProjectURL" target="_blank" class="project-link demo-link"
                                                                            title="Demo">
                                                                            <i class="fas fa-external-link-alt"></i>
                                                                        </a>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="project-content">
                                                        <h6 class="project-title">@project.ProjectName</h6>
                                                        @if (!string.IsNullOrEmpty(project.Description))
                                                        {
                                                            <p class="project-description">@project.Description</p>
                                                        }
                                                        @if (!string.IsNullOrEmpty(project.Technologies))
                                                        {
                                                            <div class="project-tech mb-3">
                                                                @foreach (var tech in project.Technologies.Split(',',
                                                                                                    StringSplitOptions.RemoveEmptyEntries))
                                                                {
                                                                    <span class="tech-tag">@tech.Trim()</span>
                                                                }
                                                            </div>
                                                        }
                                                        <div class="project-links">
                                                            @if (!string.IsNullOrEmpty(project.GitHubURL))
                                                            {
                                                                <a href="@project.GitHubURL" target="_blank"
                                                                    class="btn btn-outline-dark btn-sm me-2">
                                                                    <i class="fab fa-github me-1"></i>GitHub
                                                                </a>
                                                            }
                                                            @if (!string.IsNullOrEmpty(project.ProjectURL))
                                                            {
                                                                <a href="@project.ProjectURL" target="_blank" class="btn btn-primary btn-sm">
                                                                    <i class="fas fa-external-link-alt me-1"></i>Xem website
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-5">
                                        <i class="fas fa-code fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">Đang tải dự án...</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>



                <!-- Footer -->
                <footer class="bio-footer">
                    <p><i class="fas fa-copyright"></i> 2025 Xuan Hoang - All rights reserved</p>
                    <p><a href="https://dxhoang.site" target="_blank">dxhoang.site</a></p>
                </footer>
            </div>
        </div>
    }
}

@code {
    private AboutMeDto? aboutMe;
    private List<ProjectDto> projects = new();
    private ContactInfoDto? contact;
    private bool isLoading = true;
    private bool isServerDown = false;
    private string serverErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        // Subscribe to server status changes
        ApiService.ServerStatusChanged += OnServerStatusChanged;

        // Check server health first
        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBioData();
        }
    }

    private void OnServerStatusChanged(bool isHealthy, string errorMessage)
    {
        isServerDown = !isHealthy;
        serverErrorMessage = errorMessage;

        InvokeAsync(StateHasChanged);
    }

    private async Task LoadBioData()
    {
        try
        {
            isLoading = true;

            // Load all data concurrently
            var aboutMeTask = ApiService.GetAboutMeAsync();
            var projectsTask = ApiService.GetPublishedProjectsAsync();
            var contactTask = ApiService.GetContactInfoDto();

            await Task.WhenAll(aboutMeTask, projectsTask, contactTask);

            aboutMe = await aboutMeTask;
            projects = await projectsTask;
            contact = await contactTask;

            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading bio data: {ex.Message}");
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleRetry()
    {
        isServerDown = false;
        serverErrorMessage = "";
        StateHasChanged();

        var isServerHealthy = await ApiService.CheckServerHealthAsync();
        if (isServerHealthy)
        {
            await LoadBioData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("console.log", "Bio page loaded");
        }
    }

    private string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrEmpty(imageUrl))
            return "";

        if (imageUrl.StartsWith("http"))
            return imageUrl;

        return $"https://localhost:7254{imageUrl}";
    }

    public void Dispose()
    {
        ApiService.ServerStatusChanged -= OnServerStatusChanged;
    }
}

<style>
    /* Bio Main Layout */
    .bio-main {
        background: #f8f9fa;
        min-height: 100vh;
        padding: 0;
    }

    .bio-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    /* Bio Header - Full width */
    .bio-header {
        background: white;
        width: 100%;
        padding: 3rem 0;
        margin-bottom: 0;
    }

    .bio-avatar {
        width: 200px;
        height: 200px;
        object-fit: cover;
        border: 4px solid white;
    }

    .bio-avatar-placeholder {
        width: 200px;
        height: 200px;
        background: #f8f9fa;
        border: 4px solid white;
    }

    .bio-name {
        font-size: 2.5rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .bio-job-title {
        font-size: 1.5rem;
        color: #6c757d;
        font-weight: 400;
        margin-bottom: 1rem;
    }

    .bio-summary {
        font-size: 1.1rem;
        line-height: 1.6;
        color: #666;
    }

    /* Info Boxes Section */
    .info-boxes-section {
        padding: 3rem 0;
    }

    .info-box {
        background: white;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }

    .info-box:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1) !important;
    }

    .info-box-header {
        padding: 1.5rem 1.5rem 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .info-box-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
    }

    .info-box-body {
        padding: 1rem 1.5rem 1.5rem;
    }

    /* Contact Items - Each item on separate line */
    .contact-items-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .contact-item {
        display: flex;
        align-items: center;
        font-size: 0.95rem;
    }

    /* Social Links - centered */
    .social-links {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        min-height: 80px;
    }

    /* Portfolio Links - 2 buttons per row, centered */
    .portfolio-links {
        display: flex;
        flex-direction: row;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        min-height: 80px;
    }

    .portfolio-btn {
        display: inline-flex;
        align-items: center;
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        font-size: 0.8rem;
        flex: 1;
        min-width: 0;
        justify-content: center;
        height: 48px;
    }

    .github-portfolio {
        background: #333;
        color: white;
    }

    .github-portfolio:hover {
        background: #555;
        color: white;
    }

    .cv-portfolio {
        background: #dc3545;
        color: white;
    }

    .cv-portfolio:hover {
        background: #c82333;
        color: white;
    }

    /* Projects Section */
    .projects-section {
        padding: 2rem 0;
    }

    .projects-container {
        max-width: 80%;
        margin: 0 auto;
    }

    /* Social Buttons - Fixed width like portfolio buttons */
    .social-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        color: white;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 500;
        transition: all 0.3s ease;
        height: 48px;
        min-width: 120px;
        max-width: 140px;
    }

    .social-btn:hover {
        transform: translateY(-2px);
        color: white;
        opacity: 0.9;
    }

    .facebook-btn {
        background-color: #1877f2;
    }

    .linkedin-btn {
        background-color: #0077b5;
    }

    .github-btn {
        background-color: #333;
    }

    /* Project Cards */
    .project-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
    }

    .project-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .project-image {
        height: 180px;
        overflow: hidden;
        background: #f8f9fa;
        position: relative;
    }

    .project-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .project-card:hover .project-image img {
        transform: scale(1.05);
    }

    .project-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .project-card:hover .project-overlay {
        opacity: 1;
    }

    .project-links {
        display: flex;
        gap: 10px;
    }

    .project-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        background: white;
        color: #333;
        border-radius: 50%;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .project-link:hover {
        transform: scale(1.1);
        color: #007bff;
    }

    .project-content {
        padding: 1.5rem;
    }

    .project-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .project-description {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 1rem;
    }

    .tech-tag {
        background: #e9ecef;
        color: #495057;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .bio-name {
            font-size: 2rem;
        }

        .bio-job-title {
            font-size: 1.25rem;
        }

        .bio-avatar,
        .bio-avatar-placeholder {
            width: 150px;
            height: 150px;
        }

        .bio-header {
            padding: 2rem 0;
        }

        .info-boxes-section {
            padding: 2rem 0;
        }

        .projects-container {
            max-width: 95%;
        }

        .portfolio-links {
            flex-direction: row;
            gap: 6px;
        }

        .portfolio-btn {
            font-size: 0.7rem;
            padding: 0.35rem 0.5rem;
        }

        .social-btn {
            min-width: 100px;
            max-width: 120px;
            font-size: 0.75rem;
        }
    }
</style>
